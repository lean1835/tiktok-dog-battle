{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TikTokDogBattleContract",
  "description": "Giao ước dữ liệu P2P cho Hệ thống Nhân vật Chó Chibi 2.5D trong tiktok-dog-battle",
  "version": "1.0.0",
  "models": {
    "DogBreed": {
      "type": "string",
      "enum": [
        "corgi",
        "shiba",
        "husky",
        "pitbull",
        "pug",
        "poodle",
        "becgie",
        "golden",
        "doberman",
        "chota"
      ]
    },
    "DogState": {
      "type": "string",
      "enum": [
        "idle",
        "barking",
        "exhausted",
        "evolved_tiger",
        "evolved_dragon"
      ]
    },
    "DogTeam": {
      "type": "string",
      "enum": ["red", "blue", "none"]
    },
    "DogCharacter": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "breed": { "$ref": "#/models/DogBreed" },
        "name": { "type": "string", "description": "Tên Chibi chuẩn: Tuất + [Tên]" },
        "rawNickname": { "type": "string" },
        "team": { "$ref": "#/models/DogTeam" },
        "avatar": { "type": "string" },
        "hp": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxHp": { "type": "number", "default": 100 },
        "state": { "$ref": "#/models/DogState" },
        "barkPower": { "type": "number" },
        "streak": { "type": "integer" },
        "buffMultiplier": { "type": "number", "default": 1 },
        "accessory": {
          "type": "object",
          "properties": {
            "bandana": { "type": "string", "enum": ["red", "blue", "gold", "none"] },
            "hasSpikeCollar": { "type": "boolean" },
            "hasCrown": { "type": "boolean" }
          }
        }
      },
      "required": ["id", "breed", "name", "team", "state", "hp"]
    },
    "BreedMetadata": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameVi": { "type": "string" },
        "description": { "type": "string" },
        "specialTrait": { "type": "string" },
        "colors": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" },
            "accent": { "type": "string" }
          },
          "required": ["primary", "secondary"]
        }
      },
      "required": ["id", "nameVi", "colors"]
    }
  },
  "api": {
    "getAllBreeds": "DogRenderer.getAllBreeds() // Danh sách 10 giống chó 2D",
    "getBreedInfo": "DogRenderer.getBreedInfo(breedKey) // Thông tin chi tiết giống",
    "createCharacter": "DogRenderer.createCharacter(params) // Tạo mới nhân vật chó Chibi",
    "renderToCanvas": "DogRenderer.renderToCanvas(ctx, dog, x, y, size, animTime) // Vẽ trực tiếp lên HTML5 Canvas",
    "renderToSVG": "DogRenderer.renderToSVG(dog, size, animTime, flip) // Xuất chuỗi SVG vector độc lập",
    "renderDog": "DogRenderer.renderDog(breedId, options) // Hàm tiện ích nhanh",
    "createDog3D": "Dog3DEngine.createDog(THREE, charId, { team, state }) // Khởi tạo model 3D procedural low-poly với đầy đủ rigging",
    "createArena3D": "Dog3DEngine.createArena(THREE) // Khởi tạo sàn đấu 3D Isometric với vạch chia và cỏ xanh",
    "dog3DActions": "dog3D.bark() // Sủa chồm lên bung sóng âm 3D, dog3D.pant() // Thở dốc thè lưỡi, dog3D.update(delta, time) // Animation loop"
  }
}
